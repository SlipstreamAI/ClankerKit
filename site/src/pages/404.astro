---
import Base from "../layouts/Base.astro";
---

<Base title="Not found · ClankerKit" description="That page is not in the ClankerKit catalog.">
  <main class="mx-auto max-w-3xl px-5 py-16">
    <h1 class="font-display text-6xl">Not in the catalog.</h1>
    <p class="mt-4 text-lg">The skill or page you asked for is not on this site.</p>
    <a class="mt-6 inline-block border border-ink px-3 py-2 font-semibold" href="/skills">Browse skills</a>
  </main>
</Base>

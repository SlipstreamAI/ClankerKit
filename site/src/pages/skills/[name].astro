---
import Base from "../../layouts/Base.astro";
import InstallTabs from "../../components/InstallTabs.astro";
import { installCommands, loadCatalog, loadSkill, relatedSkills } from "../../lib/content";

export function getStaticPaths() {
  return loadCatalog().skills.map((skill) => ({
    params: { name: skill.name },
    props: { name: skill.name },
  }));
}

const { name } = Astro.props;
const skill = loadSkill(name);
const related = relatedSkills(skill);
const commands = installCommands(skill.name);
const rawUrl = `https://github.com/SlipstreamAI/ClankerKit/blob/main/${skill.path}`;
const editUrl = `https://github.com/SlipstreamAI/ClankerKit/edit/main/${skill.path}`;
---

<Base title={`${skill.name} · ClankerKit`} description={skill.description} image={`/og/${skill.name}.svg`}>
  <main class="mx-auto grid max-w-6xl gap-8 px-5 py-10 lg:grid-cols-[minmax(0,1fr)_320px]">
    <article data-pagefind-body>
      <p class="font-mono text-xs uppercase tracking-widest" data-pagefind-filter="category">
        {skill.category}
      </p>
      <div class="mt-2 flex flex-wrap items-center gap-3">
        <h1 class="font-display text-5xl leading-none">{skill.name}</h1>
        <span class:list={["stamp", `stamp-${skill.status}`]} data-pagefind-filter="status">{skill.status}</span>
      </div>
      <p class="mt-4 max-w-3xl text-xl">{skill.description}</p>
      <p class="mt-3 font-mono text-xs">
        tags {skill.tags.join(", ")} · modes {skill.modes.join(", ")} · v{skill.metadata.version}
      </p>

      <div class="prose-skill mt-8 max-w-3xl" set:html={skill.html} />

      <details class="mt-8 border border-line bg-card p-4" data-pagefind-ignore>
        <summary class="cursor-pointer font-semibold">Raw SKILL.md</summary>
        <div class="mt-3 flex gap-2">
          <button type="button" data-copy-target="raw-skill" class="border border-ink px-3 py-1 text-sm">
            Copy SKILL.md
          </button>
          <button type="button" data-copy={rawUrl} class="border border-ink px-3 py-1 text-sm">Copy raw URL</button>
        </div>
        <textarea id="raw-skill" class="hidden" readonly>{skill.raw}</textarea>
        <pre class="mt-3 max-h-[32rem] overflow-auto bg-plate p-3 font-mono text-xs text-card">{skill.raw}</pre>
      </details>
    </article>

    <aside class="space-y-6 lg:sticky lg:top-6 lg:self-start" data-pagefind-ignore>
      <section>
        <h2 class="font-display text-3xl">Install</h2>
        <div class="mt-3">
          <InstallTabs commands={commands} />
        </div>
      </section>
      <section class="border border-line bg-card p-4">
        <h2 class="font-display text-2xl">Files</h2>
        <ul class="mt-2 space-y-1 font-mono text-xs">
          <li>SKILL.md</li>
          {skill.files.map((file) => <li>{file}</li>)}
          {skill.files.length === 0 && <li>No extra files.</li>}
        </ul>
        <p class="mt-3 text-sm">Tools: {skill.allowed_tools.join(" ")}</p>
        <p class="mt-2 text-sm">{skill.compatibility}</p>
        <a class="mt-3 inline-block text-sm font-semibold text-link" href={editUrl}>Edit on GitHub</a>
      </section>
      <section>
        <h2 class="font-display text-2xl">Related</h2>
        <ul class="mt-2 space-y-2">
          {
            related.map((item) => (
              <li>
                <a class="text-link" href={`/skills/${item.name}`}>
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </aside>
  </main>
</Base>
